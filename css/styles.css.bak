:root{
  --bg:#020a19;
  --surface:#0f1724;
  --surface-alt:#13203a;
  --text:#ffffff;
  --muted:#d8e0c0;
  --accent:#CCD67F;
  --accent-strong:#f2f6c7;
  --card:#10203a;
  --card-soft:#121d2f;
  --border:#1d314f;
  --max:1150px;
  --radius:22px;
  --gap:1.5rem;
  --container-pad:1.25rem;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
html,body{min-height:100%;margin:0;padding:0;font-family:'Inter', 'Segoe UI', sans-serif;color:var(--text);background:radial-gradient(circle at top,#0d1f3d 0%,#020911 45%,#020a19 100%);line-height:1.6}
body{overflow-x:hidden}
.container{max-width:var(--max);margin:0 auto;padding:0 var(--container-pad)}

a:not(.btn){color:var(--accent);transition:color 180ms ease,transform 180ms ease}
a:not(.btn):hover{color:#ffffff;text-decoration:underline}

.site-header{position:sticky;top:0;background:rgba(1,11,29,0.94);border-bottom:1px solid rgba(255,255,255,0.08);backdrop-filter:blur(18px);box-shadow:0 20px 45px rgba(0,0,0,0.25);z-index:40}
.header-inner{display:flex;align-items:center;justify-content:space-between;padding:1rem 0}
.brand{display:flex;align-items:center;gap:1rem;text-decoration:none;color:var(--text)}
.brand-mark{flex:0 0 80px;width:80px;height:80px;object-fit:cover;border-radius:24px;box-shadow:0 20px 48px rgba(204,214,127,0.35);border:2px solid rgba(204,214,127,0.25)}
.brand-name{font-weight:800;font-size:1.25rem;letter-spacing:0.1em;text-transform:uppercase}

.nav-toggle{display:none;background:none;border:0;color:var(--text);font-size:1.5rem;cursor:pointer}
.primary-nav{display:flex;gap:1rem;align-items:center}
.primary-nav a{color:var(--accent);text-decoration:none;padding:0.5rem 0.75rem;border-radius:10px;transition:all 220ms ease}
.primary-nav a:hover{background:rgba(204,214,127,0.16);color:#ffffff;transform:translateY(-1px)}
.primary-nav a.cta{background:var(--accent);color:#020a19;box-shadow:0 16px 28px rgba(204,214,127,0.25)}
.primary-nav a.cta:hover{transform:translateY(-2px);box-shadow:0 18px 32px rgba(204,214,127,0.35)}

.hero{padding:4rem 0 3rem}
.hero-inner{display:grid;grid-template-columns:1fr minmax(320px,480px);gap:clamp(1rem,4vw,2rem);align-items:center}
.hero-copy h1{font-size:clamp(2rem,4vw,3.2rem);line-height:1.05;margin:0 0 1rem;letter-spacing:-0.03em}
.hero-copy p{max-width:620px;color:var(--muted);font-size:1rem}
.hero-copy .btn{font-size:1rem;padding:0.95rem 1.6rem;background:var(--accent);color:#020a19;border-radius:16px;box-shadow:0 18px 40px rgba(204,214,127,0.25);transition:transform 220ms ease,box-shadow 220ms ease,filter 220ms ease}
.hero-copy .btn:hover{transform:translateY(-2px);box-shadow:0 26px 54px rgba(204,214,127,0.32);filter:brightness(1.05)}
.hero-media{display:flex;justify-content:center}
.image-frame{width:100%;max-width:460px;border-radius:32px;padding:24px;background:linear-gradient(180deg,rgba(255,255,255,0.1),rgba(14,24,50,0.75));box-shadow:0 32px 70px rgba(0,0,0,0.22);transform:rotate(-2deg)}
.image-frame img{display:block;width:100%;height:360px;object-fit:cover;border-radius:24px;border:1px solid rgba(255,255,255,0.08)}

.section{padding:2.5rem 0}
.section h2{color:#ffffff;margin-bottom:1.2rem;letter-spacing:0.02em}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.4rem}
.card{background:var(--card);padding:1.25rem;border-radius:24px;display:flex;flex-direction:column;gap:1rem;align-items:start;box-shadow:0 16px 40px rgba(0,0,0,0.16);border:1px solid rgba(255,255,255,0.05)}
.card img{width:100%;height:160px;object-fit:cover;border-radius:18px;flex-shrink:0}
.card h3{margin:0;color:#ffffff}
.card p{margin:0;color:var(--muted)}

.products-grid .product{background:rgba(255,255,255,0.05);border-radius:22px;overflow:hidden;text-align:center;box-shadow:0 18px 40px rgba(0,0,0,0.18);border:1px solid rgba(255,255,255,0.05)}
.products-grid img{width:100%;height:200px;object-fit:cover;display:block}
.products-grid h4{margin:0.75rem 0 1rem;color:#ffffff}

.contact-inner{display:grid;grid-template-columns:1fr 320px;gap:1.5rem;align-items:start}
.contact-form h2{margin-top:0;color:#ffffff}
.contact-form p{color:var(--muted)}
.contact-form .btn{display:inline-block;padding:0.9rem 1.5rem;background:var(--accent);color:#020a19;border-radius:14px;text-decoration:none;transition:transform 220ms ease,box-shadow 220ms ease,filter 220ms ease}
.contact-form .btn:hover{transform:translateY(-2px);box-shadow:0 22px 38px rgba(204,214,127,0.28);filter:brightness(1.05)}
.btn.ghost{background:rgba(255,255,255,0.08);color:#eef5ff;box-shadow:inset 0 0 0 1px rgba(255,255,255,0.08);transition:background 180ms ease,transform 180ms ease}
.btn.ghost:hover{background:rgba(255,255,255,0.14);transform:translateY(-1px)}

.site-footer{border-top:1px solid rgba(255,255,255,0.08);padding:1.25rem 0;background:transparent}
.footer-inner{display:flex;flex-direction:column;gap:6px;align-items:center;color:var(--muted)}

/* Responsive */
@media (max-width:900px){
  .hero-inner{grid-template-columns:1fr}
  .contact-inner{grid-template-columns:1fr}
}
@media (max-width:720px){
  .nav-toggle{display:block}
  .primary-nav{position:absolute;right:1rem;top:68px;background:rgba(4,18,42,0.96);padding:1rem;border-radius:16px;box-shadow:0 14px 48px rgba(0,0,0,0.35);flex-direction:column;display:none;min-width:220px}
  .primary-nav.open{display:flex}
  .primary-nav a{width:100%}
}

/* Accessibility helpers */
.brand:focus,.primary-nav a:focus,.btn:focus{outline:3px solid rgba(204,214,127,0.35);outline-offset:3px}
